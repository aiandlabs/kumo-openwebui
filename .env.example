# Required: your ai& API key (https://console.aiand.com)
AIAND_API_KEY=

# Keys for Kumo's API. Open WebUI uses the read key for its tools (unless WEBUI_KUMO_KEY is set) and the terminal.
KUMO_API_KEY=change-me-write
KUMO_READ_KEY=change-me-read
# Optional: the key Open WebUI's Kumo tools use. Empty means KUMO_READ_KEY (read-only). Set it to the
# KUMO_API_KEY value to let models add notes to deals; they ask the user before writing.
WEBUI_KUMO_KEY=

# Open WebUI signs sessions with this. Set it once and keep it (openssl rand -hex 32).
WEBUI_SECRET_KEY=change-me-session

# Open Terminal's own API key.
OPEN_TERMINAL_API_KEY=change-me-terminal

# Optional: pin "today" so the demo data always looks the same.
KUMO_TODAY=2026-10-26

# Optional: the debug panel at /debug shows every call to the ai& API, from Kumo and from
# Open WebUI. It stores prompts and answers, so use it only for demos and development.
KUMO_DEBUG=1

# Optional: host ports.
KUMO_PORT=8080
WEBUI_PORT=3000

# Optional: keep Open WebUI's "Kumo CRM" knowledge base in step with the deals (kumo/kbsync.py).
# Kumo signs in to Open WebUI as this user, which owns the knowledge base. Leave empty to turn it off.
KUMO_OWUI_EMAIL=
KUMO_OWUI_PASSWORD=

# Optional: ai& embeddings and rerank are in private preview. With access, set the endpoint here,
# and any headers it needs as a JSON object (for example {"X-Example": "value"}), then add
# docker-compose.aiand-embeddings.yml (see that file).
KUMO_EMBEDDINGS_URL=
KUMO_EMBEDDINGS_HEADERS=
